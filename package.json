{
  "name": "@accessiblewebmedia/ionic-angular-init",
  "version": "1.0.0",
  "description": "CLI tool to initialize Ionic Angular projects with Firebase configuration",
  "main": "dist/cli.js",
  "bin": {
    "accessiblewebmedia-init": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --outDir dist --minify",
    "dev": "tsup src/cli.ts --format cjs --outDir dist --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "build:cli": "node scripts/build.js",
    "test:cli": "node scripts/test-cli.js",
    "publish:cli": "node scripts/publish.js"
  },
  "keywords": [
    "ionic",
    "angular",
    "firebase",
    "cli",
    "init",
    "scaffold"
  ],
  "author": "Accessible Web Media",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "fs-extra": "^11.2.0",
    "ejs": "^3.1.9",
    "semver": "^7.5.4",
    "jsonc-parser": "^3.2.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/semver": "^7.5.6",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "templates"
  ]
}
